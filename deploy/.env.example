# A DNS hostname only: no https:// prefix, port, or path.
HYA_DOMAIN=demo.example.com
HYA_DEMO_USER=demo
# Generate with: docker run --rm -it caddy:2-alpine caddy hash-password --algorithm bcrypt
# Paste the entire generated hash inside these single quotes. Single quotes
# prevent Docker Compose from interpreting the dollar signs in a bcrypt hash.
HYA_PASSWORD_HASH=''

# Open-source ASR executes on the demo server; no speech API key is required.
# Benchmark the complete CPU pipeline on the host before treating it as ready.
# These paths refer to the writable container model-cache volume.
HYA_SENSEVOICE_MODEL_PATH=/var/cache/hear-you-are/sensevoice/model.int8.onnx
HYA_SENSEVOICE_TOKENS_PATH=/var/cache/hear-you-are/sensevoice/tokens.txt
HYA_SILERO_VAD_MODEL_PATH=/var/cache/hear-you-are/sensevoice/silero_vad.onnx
HYA_SENSEVOICE_CHUNK_SECONDS=30
HYA_SENSEVOICE_NUM_THREADS=4
# Required anonymous speaker separation, using the writable model-cache volume.
HYA_DIARIZATION_SEGMENTATION_PATH=/var/cache/hear-you-are/diarization/segmentation.onnx
HYA_DIARIZATION_EMBEDDING_PATH=/var/cache/hear-you-are/diarization/embedding.onnx
HYA_DIARIZATION_THRESHOLD=0.5
HYA_DIARIZATION_NUM_THREADS=2

# Only text and relevant memories go to the official DeepSeek API, not audio.
# Four official keys: one for each required semantic stage.
HYA_DEEPSEEK_BASE_URL=https://api.deepseek.com
HYA_DEEPSEEK_MODEL=deepseek-flash
HYA_DEEPSEEK_ATOMIC_API_KEY=
HYA_DEEPSEEK_CONSOLIDATION_API_KEY=
HYA_DEEPSEEK_RETRIEVAL_API_KEY=
HYA_DEEPSEEK_GOVERNANCE_API_KEY=
# Optional extra key: transcript text-quality review; empty means skipped.
HYA_DEEPSEEK_RAW_EVIDENCE_API_KEY=
# Optional per-stage model IDs inherit HYA_DEEPSEEK_MODEL when omitted.
# HYA_DEEPSEEK_RAW_EVIDENCE_MODEL=
# HYA_DEEPSEEK_ATOMIC_MODEL=
# HYA_DEEPSEEK_CONSOLIDATION_MODEL=
# HYA_DEEPSEEK_RETRIEVAL_MODEL=
# HYA_DEEPSEEK_GOVERNANCE_MODEL=

# Optional card-model overrides; blank reuses the DeepSeek retrieval settings.
HYA_LLM_BASE_URL=
HYA_LLM_MODEL=
HYA_LLM_API_KEY=
