# 本機資料及模型不會提交到 GitHub。
HYA_DATA_DIR=./data
HYA_ASR_MODEL=large-v3-turbo
HYA_ASR_DEVICE=auto
HYA_ASR_COMPUTE_TYPE=auto
# 可使用已下載的模型資料夾；空值使用 Hugging Face 的本機快取。
HYA_ASR_MODEL_DIR=
HYA_MAX_UPLOAD_MB=100
HYA_MAX_AUDIO_MINUTES=20
# 可選：OpenAI 相容的本機 LLM（例如 Ollama /v1）。預設不外傳轉錄文字。
HYA_LLM_BASE_URL=
HYA_LLM_MODEL=
HYA_LLM_API_KEY=
HYA_ALLOW_EXTERNAL_LLM=false
