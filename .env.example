# Server-side secrets only. Copy to .env locally; never commit actual values.
HYA_DATA_DIR=./data
HYA_DEPLOYMENT_MODE=local
HYA_ALLOWED_HOSTS=localhost,127.0.0.1,::1,testserver

# Open-source speech inference on this device (or on the deployed server).
# No speech API account/key is required; model weights must be downloaded.
HYA_ASR_PROVIDER=sensevoice
HYA_MAX_UPLOAD_MB=100
HYA_MAX_AUDIO_MINUTES=20
# SenseVoiceSmall INT8 and Silero VAD: CPU-only, no PyTorch/CUDA/aligner.
HYA_SENSEVOICE_MODEL_PATH=./models/sensevoice/model.int8.onnx
HYA_SENSEVOICE_TOKENS_PATH=./models/sensevoice/tokens.txt
HYA_SILERO_VAD_MODEL_PATH=./models/sensevoice/silero_vad.onnx
HYA_SENSEVOICE_CHUNK_SECONDS=30
HYA_SENSEVOICE_NUM_THREADS=4
# VAD and local speaker separation are mandatory for this provider.
# Anonymous speaker labels do not identify the user.
HYA_DIARIZATION_SEGMENTATION_PATH=./models/diarization/segmentation.onnx
HYA_DIARIZATION_EMBEDDING_PATH=./models/diarization/embedding.onnx
HYA_DIARIZATION_THRESHOLD=0.5
HYA_DIARIZATION_NUM_THREADS=2

# Transcript text / relevant memories go directly to the official DeepSeek API.
HYA_MEMORY_MODE=deepseek
HYA_ALLOW_EXTERNAL_LLM=true
HYA_DEEPSEEK_BASE_URL=https://api.deepseek.com
# Configuration alone is not proof of a successful live request.
HYA_DEEPSEEK_MODEL=deepseek-flash
# Four official keys: one for each required semantic stage.
HYA_DEEPSEEK_ATOMIC_API_KEY=
HYA_DEEPSEEK_CONSOLIDATION_API_KEY=
HYA_DEEPSEEK_RETRIEVAL_API_KEY=
HYA_DEEPSEEK_GOVERNANCE_API_KEY=
# Optional extra key: text-quality review, not speech transcription.
# Leave empty to skip this additional stage.
HYA_DEEPSEEK_RAW_EVIDENCE_API_KEY=
# Optional per-stage model override: HYA_DEEPSEEK_<STAGE>_MODEL, where STAGE is
# RAW_EVIDENCE, ATOMIC, CONSOLIDATION, RETRIEVAL or GOVERNANCE.

# Leave blank to reuse DeepSeek base/model/retrieval key for on-demand cards.
HYA_LLM_BASE_URL=
HYA_LLM_MODEL=
HYA_LLM_API_KEY=
